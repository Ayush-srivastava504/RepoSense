# Copy to ".env" in this folder (infrastructure/docker/.env) and fill in.
# Never commit the real .env.

# ---- Domains (DNS A records for BOTH must point at this server before first start) ----
DOMAIN=intern-flow.in
API_DOMAIN=api.intern-flow.in

# ---- Database ----
# Generate with: openssl rand -hex 24   (hex only: it is embedded in a URL)
POSTGRES_PASSWORD=

# ---- Secrets (generate each one; do not reuse) ----
# openssl rand -hex 32
JWT_SECRET=
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GITHUB_TOKEN_ENCRYPTION_KEY=
# Same value is used by the API and the web app so SSR is not rate limited.  openssl rand -hex 32
INTERNAL_API_KEY=

# ---- GitHub OAuth (optional, for the GitHub terminal / code review) ----
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Must match the callback URL set in your GitHub OAuth app
GITHUB_REDIRECT_URI=https://api.intern-flow.in/api/github/callback

# ---- Payments / email (optional) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RESEND_API_KEY=

# ---- LLM providers for content enrichment (optional; falls back to templates) ----
GROQ_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=

# ---- Frontend build-time (optional) ----
NEXT_PUBLIC_LOGO_DEV_TOKEN=
