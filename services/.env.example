# Backend
DATABASE_URL=postgresql://postgres:password@localhost:5432/internship_db
REDIS_URL=redis://localhost:6379
JWT_SECRET=change_this_to_random_string
GITHUB_TOKEN_ENCRYPTION_KEY=change_this_to_fernet_key
GITHUB_CLIENT_ID=your_github_app_client_id
GITHUB_CLIENT_SECRET=your_github_app_secret
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
AWS_ACCESS_KEY=AKIA...
AWS_SECRET_KEY=...
S3_BUCKET=resume-storage

# Groq API key — used by the crawler's automatic content-enrichment
# hook (services/api/crawler/src/content_enrichment.py, runs at the end
# of every crawl), the daily catch-up job
# (services/api/scripts/enrich_job_content.py), and the bulk/fallback
# runner covering all jobs, companies, and SEO blog posts
# (services/api/scripts/enrich_all_content.py) to generate overview,
# work-culture, and keyword copy. Leave empty and all three fall back to
# a deterministic template generator instead of skipping — content still
# gets written, just without AI-generated copy.
GROQ_API_KEY=

# Set only in the environment you're load testing, only for the duration
# of the test. Leave empty in production. See services/api/loadtest/README.md
LOAD_TEST_BYPASS_KEY=

# Shared secret for server-to-server calls from the Next.js app (SSR/ISR/sitemaps).
# Set the SAME random value here (API host) and as INTERNAL_API_KEY in the web
# app's server environment (Vercel; NOT a NEXT_PUBLIC_ variable). Requests that
# carry it as `X-Internal-Key` skip the per-IP rate limit. Leave empty to disable.
INTERNAL_API_KEY=

# Phase F — same-day priority indexing push (see
# INDEXING_RECOVERY_PLAN.md and scripts/phase_f_priority_index_push.py).
# INDEXNOW_KEY/INDEXNOW_HOST already have working defaults matching the
# key already deployed at apps/web/public/<key>.txt — only override if
# you rotate the key. GOOGLE_INDEXING_SERVICE_ACCOUNT_JSON is the full
# contents of a GCP service-account key file (one line, JSON) for a
# service account that's been added as an Owner on this site's Search
# Console property and has the Indexing API enabled on its project.
# Leave it empty to push to IndexNow only (Google leg is skipped, not an
# error).
INDEXNOW_KEY=
INDEXNOW_HOST=
GOOGLE_INDEXING_SERVICE_ACCOUNT_JSON=
GOOGLE_INDEXING_DAILY_QUOTA=180

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000